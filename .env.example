# Asset Swap - Production Environment Variables Template

# Application Environment
NODE_ENV=production
PORT=3001

# Database Persistence Path
# On Render or Linux servers with a persistent volume: /var/data/asset_swap.db
# On local development: asset_swap.db
DATABASE_PATH=asset_swap.db

# Initial Admin Bootstrap (Executed once on first boot if no admin account exists)
ADMIN_BOOTSTRAP_EMAIL=admin@asset-swap.local
ADMIN_BOOTSTRAP_PASSWORD=Admin@Production2026!

# Allowed Origin for CORS (Optional; leave unset for same-origin)
# APP_ORIGIN=https://asset-swap.onrender.com
